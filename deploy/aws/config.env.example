# -------------------------------------------------------------------------
# deal_flow deploy inputs.  Copy to config.env (gitignored) and fill in.
#   cp config.env.example config.env && $EDITOR config.env
# Only the values below change per-deploy; fixed infra IDs live in _common.sh
# (already verified by 00-verify.sh).
# -------------------------------------------------------------------------

# AWS target — leave as-is unless the account/region changes.
export AWS_PROFILE=prod
export AWS_REGION=ap-south-1

# Image tag to build, push, and run. Bump (v2, v3…) for each redeploy.
export IMAGE_TAG=v1

# --- DB: point at the READ-REPLICA (cart is read-only SELECTs) ------------
export DB_HOST=          # e.g. bijnis-live-replica-db.internal.bijnis.co
export DB_PORT=3306
export DB_USER=          # least-privilege, SELECT-only if possible
export DB_PASSWORD=      # stored as an SSM SecureString, never in the image
export DB_NAME=          # e.g. shoekonnect_live

# --- Auth: MUST equal the gateway's config.authKey -----------------------
# Read it from the gateway prod config YAML. If these differ, every /api/*
# call fails the Auth-Key check inside deal_flow.
export AUTH_KEY=

# Do NOT set SELLER_ID in prod — the seller comes from the gateway-injected
# Seller-Id header. A missing header then correctly yields 400, not a wrong
# seller's cart.
